# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here

# Database Configuration
DATABASE_URL=sqlite:///./rag_system.db

# Admin Configuration
ADMIN_PASSWORD=your_secure_password_here

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# Set true on Cloud Run when using request-based billing so the demo knowledge
# bases are indexed before the service begins accepting traffic.
BLOCK_STARTUP_UNTIL_SEEDED=false
